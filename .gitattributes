* text=auto
*.py text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.glb binary
*.pdf binary
*.png binary
# These files are identified by raw-byte hashes in saved FEM provenance.
# Keep the same bytes on Windows and Linux checkouts.
fem/*.py -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
data/bridges/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
